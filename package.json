{
  "name": "cereal",
  "productName": "Cereal",
  "desktopName": "cereal.desktop",
  "version": "0.1.0",
  "description": "AI meeting notepad for Linux: take notes, Cereal listens and writes them up.",
  "main": "out/main/index.js",
  "author": "David Ji <davidji0011@gmail.com>",
  "homepage": "https://github.com/Self-controller",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "postinstall": "electron-builder install-app-deps",
    "update-app": "bash scripts/flatpak.sh --install",
    "flatpak": "bash scripts/flatpak.sh",
    "e2e": "electron-vite build && node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@google/genai": "2.29.1",
    "better-sqlite3": "13.0.3",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "openai": "7.39.0",
    "unpdf": "1.8.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.59.0",
    "motion": "13.5.1",
    "playwright-core": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  }
}
